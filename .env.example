# Vyse — environment variables. Copy to `.env` and edit.

# ── Core ──────────────────────────────────────────────
VYSE_ENV=dev
VYSE_LOG_LEVEL=INFO
VYSE_LOG_JSON=false

# ── API ───────────────────────────────────────────────
VYSE_API_HOST=0.0.0.0
VYSE_API_PORT=8000
# VYSE_API_KEY=set-me-in-prod

# ── Database ──────────────────────────────────────────
# Dev: SQLite (zero-setup)
VYSE_DB_URL=sqlite+aiosqlite:///./vyse.db
# Prod (Docker Compose):
# VYSE_DB_URL=postgresql+asyncpg://vyse:vyse@postgres:5432/vyse

# ── Inference ─────────────────────────────────────────
VYSE_YOLO_WEIGHTS=yolov8n.pt
VYSE_YOLO_DEVICE=auto
VYSE_CONFIDENCE_THRESHOLD=0.45
VYSE_FRAME_SKIP=2
VYSE_INFERENCE_TARGET_FPS=15

# ── Storage ───────────────────────────────────────────
VYSE_SNAPSHOT_DIR=./snapshots
VYSE_SNAPSHOT_RETENTION_DAYS=30

# ── Dashboard (Next.js) ───────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
